# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:   mongodb://localhost:27017/bookleaf
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/bookleaf
MONGO_URI=mongodb://localhost:27017/bookleaf

# ─── JWT ──────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
# Exact frontend origin, no trailing slash.
# Use * for open local access. In production: https://portal.bookleaf.in
CORS_ORIGIN=*

# ─── Admin seed account ───────────────────────────────────
# All three are required by the seed script. No defaults.
ADMIN_EMAIL=admin@bookleaf.com
ADMIN_PASSWORD=change_me_strong_password
ADMIN_NAME=BookLeaf Admin

# ─── Author seed password ─────────────────────────────────
# Every author account created by the seed script gets this password.
# Required by the seed script. No default.
SEED_AUTHOR_PASSWORD=change_me_strong_password

# ─── Production seed override ─────────────────────────────
# The seed script is blocked when NODE_ENV=production.
# Set ALLOW_SEED=true to seed a production database exactly once on purpose.
# Remove this variable immediately after seeding.
ALLOW_SEED=

# ─── AI (Google Gemini) ───────────────────────────────────
# Optional. Enables automatic ticket classification on ticket creation.
# Tickets are still created with defaults (General Inquiry / Medium) if unset.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Primary model to use for classification
GEMINI_MODEL=gemini-2.0-flash
# Backup model used if GEMINI_MODEL fails after retries
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
